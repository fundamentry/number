{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.ts"
  ],
  "resolve": {
    "conditions": [
      "@fundamentry/source"
    ]
  },
  "rules": {
    "unused-dependencies": "warn",
    "private-type-leaks": "error",
    "require-suppression-reason": "error"
  },
  "health": {
    "coverage": "coverage/coverage-final.json",
    "maxCrap": 5,
    "maxCyclomatic": 5,
    "maxCognitive": 5,
    "maxUnitSize": 20,
    "crapRefactorBand": 2
  },
  "production": {
    "health": true
  },
  "boundaries": {
    "zones": [
      {
        "name": "type",
        "patterns": [
          "src/type/**"
        ]
      },
      {
        "name": "error",
        "patterns": [
          "src/error/**"
        ]
      },
      {
        "name": "util",
        "patterns": [
          "src/util/**"
        ]
      },
      {
        "name": "number",
        "patterns": [
          "src/number/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "type",
        "allow": []
      },
      {
        "from": "error",
        "allow": []
      },
      {
        "from": "util",
        "allow": [
          "type",
          "error"
        ]
      },
      {
        "from": "number",
        "allow": [
          "type",
          "error",
          "util"
        ]
      }
    ]
  },
  "ignoreDependencies": [
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "eslint-config-airbnb-base",
    "eslint-config-prettier",
    "eslint-import-resolver-typescript",
    "eslint-plugin-deprecation",
    "eslint-plugin-import",
    "eslint-plugin-json-format",
    "eslint-plugin-prettier",
    "fallow"
  ]
}
